{
  "name": "sansbev-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/lint-copy.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "sync": "astro sync",
    "check": "astro check",
    "assets:manifest": "node scripts/generate-assets-manifest.mjs",
    "todo": "grep -rn '\\[\\[PLACEHOLDER' src/ || echo 'No placeholders remaining.'",
    "lint:copy": "node scripts/lint-copy.mjs",
    "todo:doc": "node scripts/generate-todo.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.86.0"
  }
}
