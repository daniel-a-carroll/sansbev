---
/**
 * Contact. Driven entirely by src/data/site.ts — each row appears only when
 * that address exists, and the whole list is replaced by a fallback when none
 * of them do.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy } from '../data/copy';
import { site } from '../data/site';

const routes = [
  {
    label: 'Trade and wholesale',
    detail: 'Retail buyers, distributors, and brokers.',
    email: site.contact.trade,
  },
  { label: 'General', detail: 'Anything else.', email: site.contact.general },
  { label: 'Press', detail: 'Media inquiries.', email: site.contact.press },
].filter((r): r is { label: string; detail: string; email: string } => Boolean(r.email));
---

<BaseLayout title={copy.contact.seo.title} description={copy.contact.seo.description}>
  <section class="section">
    <div class="container">
      <h1>{copy.contact.heading}</h1>
      {copy.contact.intro && <p class="prose lede">{copy.contact.intro}</p>}

      {
        routes.length > 0 ? (
          <dl class="contacts">
            {routes.map((r) => (
              <div class="contacts__item">
                <dt>{r.label}</dt>
                <dd>
                  <a href={`mailto:${r.email}`}>{r.email}</a>
                  <span class="caption">{r.detail}</span>
                </dd>
              </div>
            ))}
          </dl>
        ) : (
          <p class="prose contacts__fallback">
            Contact details are not published yet. Use the{' '}
            <a href="/wholesale">wholesale inquiry form</a> and we will get back to you.
          </p>
        )
      }

      {site.contact.phone && <p class="contacts__phone">{site.contact.phone}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    margin-block-start: var(--space-sm);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
    line-height: var(--leading-tight);
  }
  .contacts { margin-block-start: var(--space-lg); border-block-start: var(--rule-strong); }
  .contacts__item { padding-block: var(--space-md); border-block-end: var(--rule); }
  .contacts dt { font-weight: var(--font-weight-medium); }
  .contacts dd { margin: var(--space-3xs) 0 0; display: grid; gap: var(--space-3xs); }
  .contacts__fallback { margin-block-start: var(--space-lg); }
  .contacts__phone { margin-block-start: var(--space-md); }
</style>
