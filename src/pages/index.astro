---
/**
 * Home. Consumer-facing, with the trade path present in the hero rather than
 * buried at the bottom — the layout admitting who the site is actually for.
 *
 * The hero can and its color field both come from the lead flavor (lowest
 * `order`), so there is no duplicate hero asset to keep in sync and reordering
 * the SKUs reskins the hero automatically.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Asset from '../components/Asset.astro';
import JsonLd from '../components/JsonLd.astro';
import SubscribeForm from '../components/forms/SubscribeForm.astro';
import { getCollection } from 'astro:content';
import { copy } from '../data/copy';
import { claims } from '../data/claims';
import { flavorSlot } from '../lib/assets';
import { organizationSchema } from '../lib/schema';

const flavors = (await getCollection('flavors', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const lead = flavors[0];

// Unconfirmed claims never render. See src/data/claims.ts.
const composition = claims.compositionPoints.filter((p) => p.confirmed);
const absence = claims.absencePoints.filter((p) => p.confirmed);

const fieldStyle = lead?.data.color
  ? `--field: ${lead.data.color.field}`
  : undefined;
---

<BaseLayout title={copy.home.seo.title} description={copy.home.seo.description}>
  <JsonLd schema={organizationSchema()} />

  <section class="hero">
    <div class="container grid hero__inner">
      <div class="hero__text">
        <p class="label">Energy drink</p>
        <h1 class="display">{copy.home.heroHeadline}</h1>
        {copy.home.heroSubhead && <p class="hero__sub">{copy.home.heroSubhead}</p>}
        <p class="hero__trade">
          <a href="/wholesale" class="accent">{copy.home.heroTradeLinkLabel}</a>
        </p>
      </div>

      <div class="hero__figure" style={fieldStyle}>
        <!-- The one orchestrated motion moment on the site: the color field
             rises once behind the can on load. Now possible because the can
             renders are transparent cutouts. Collapsed by
             prefers-reduced-motion. -->
        <div class="hero__field" aria-hidden="true"></div>
        {
          lead && (
            <Asset
              slot={flavorSlot(lead.id, 'can-front')}
              alt=""
              sizes="(min-width: 48rem) 30vw, 65vw"
              class="hero__can"
            />
          )
        }
      </div>
    </div>
  </section>

  {
    flavors.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <h2 class="visually-hidden">The flavors</h2>
          <ul class="flavors">
            {flavors.map((flavor) => (
              <li>
                <a
                  href={`/product/${flavor.id}`}
                  class="plain flavors__link"
                  style={
                    flavor.data.color
                      ? `--swatch: ${flavor.data.color.field}`
                      : undefined
                  }
                >
                  <span class="flavors__swatch" aria-hidden="true" />
                  {flavor.data.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container grid">
      <div class="hero__story prose">
        {copy.home.storyHeading && <h2>{copy.home.storyHeading}</h2>}
        {copy.home.storyBody.map((p) => <p>{p}</p>)}
      </div>

      {
        (composition.length > 0 || absence.length > 0) && (
          <div class="hero__facts">
            <h2 class="visually-hidden">What's in it</h2>
            <ul class="facts">
              {composition.map((p) => (
                <li>
                  <span class="facts__label">{p.label}</span>
                  {p.detail && <span class="caption">{p.detail}</span>}
                </li>
              ))}
              {absence.map((p) => (
                <li><span class="facts__label">{p.label}</span></li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{copy.home.emailCaptureHeading}</h2>
      {copy.home.emailCaptureBody && (
        <p class="prose capture__body">{copy.home.emailCaptureBody}</p>
      )}
      <SubscribeForm id="home-subscribe" />
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/forms';
</script>

<style>
  .hero {
    padding-block: var(--space-xl) 0;
  }

  .hero__inner {
    align-items: center;
  }

  .hero__text {
    grid-column: 1 / span 6;
  }

  .hero__text .label {
    margin-block-end: var(--space-2xs);
  }

  .hero__sub {
    max-width: var(--measure-narrow);
    margin-block-start: var(--space-md);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
    line-height: var(--leading-tight);
  }

  .hero__trade {
    margin-block-start: var(--space-lg);
    font-size: var(--text-small);
  }

  .hero__figure {
    grid-column: 8 / span 5;
    position: relative;
    display: grid;
    justify-items: center;
    align-items: end;
    padding-block-start: var(--space-lg);
  }

  /* Flat, unbounded flavor color. The can sits ON it, which the transparent
     cutouts finally allow. Not a card: no border, no radius, no shadow. */
  .hero__field {
    position: absolute;
    inset-block: 0;
    inset-inline: 8% -30%;
    background-color: var(--field, var(--color-accent));
    transform-origin: bottom;
    animation: field-rise var(--duration-considered) var(--ease-out) both;
  }

  /* :global() because the <img> is rendered inside <Asset>, so it does not
     carry this component's scope id. Nested under .hero__figure to contain it. */
  .hero__figure :global(.asset) {
    position: relative;
    max-inline-size: 19rem;
  }

  @keyframes field-rise {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field { animation: none; }
  }

  /* Flavor row. Swatches carry the packaging colors; the name carries the
     meaning, so this is not color-only information. */
  .flavors {
    display: flex;
    padding-block-start: 0;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-h3);
  }

  .flavors__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .flavors__swatch {
    inline-size: 0.85em;
    block-size: 0.85em;
    background-color: var(--swatch, var(--color-surface));
    border-radius: 50%;
  }

  .flavors__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .section--tight {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  .hero__story {
    grid-column: 1 / span 6;
  }

  .hero__facts {
    grid-column: 8 / span 5;
  }

  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-xs);
    border-block-end: var(--rule);
  }

  .facts__label {
    font-weight: var(--font-weight-medium);
  }

  .capture__body {
    margin-block: var(--space-2xs) var(--space-md);
    color: var(--color-ink-muted);
  }

  @media (max-width: 48rem) {
    .hero__figure {
      margin-block-start: var(--space-lg);
      padding-block-start: var(--space-xl);
    }
    .hero__field {
      inset-inline: -12% -12%;
    }

  }
</style>
