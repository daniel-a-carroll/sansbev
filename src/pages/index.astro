---
/**
 * HOME.
 *
 * The page is built around one idea: the name and the proof are the same
 * thing. Six real ingredients, set large, as the first substantive thing a
 * visitor reads after the headline. If the list ever moves into an accordion
 * or below the fold of a nutrition panel, the page has failed at its one job.
 *
 * Order, from the brief:
 *   1. Hero         the time claim, not the product. One CTA.
 *   2. The rule     "Never more than six." A manifesto moment.
 *   3. The six      the ingredient list as the hero element of the page.
 *   4. The math     time and money, set like a receipt.
 *   5. The drinks   three SKUs, cranberry first and dominant.
 *   6. Subscribe    every fourth case free. The capture lives here.
 *   7. FAQ          the deadpan register.
 *   (8. Footer      the caffeine advisory, in SiteFooter.)
 *
 * LAYOUT. One editorial grid throughout: a narrow margin column on the left
 * carries the small section label, the content sits to its right. Nothing is
 * centred.
 *
 * Copy is in src/data/landing.ts, figures in src/data/numbers.ts, the brand
 * name in src/data/site.ts. Nothing is written here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Tally from '../components/Tally.astro';
import Asset from '../components/Asset.astro';
import { flavorSlot } from '../lib/assets';
import JoinForm from '../components/forms/JoinForm.astro';
import { getCollection } from 'astro:content';
import { landing } from '../data/landing';
import { copy } from '../data/copy';
import { assumptions, product } from '../data/numbers';
import { organizationSchema } from '../lib/schema';

const flavors = (await getCollection('flavors', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const [lead] = flavors;

/*
 * THE SIX, derived from the flavor data so the page can never disagree with
 * the label. Every SKU has the same six slots; a slot whose value differs
 * between SKUs (today, only the named fruit) renders one span per SKU and the
 * switcher shows the selected one. If a SKU ever lists more than six, the
 * build fails here rather than quietly breaking the rule on the page.
 */
for (const f of flavors) {
  const n = f.data.ingredients?.length ?? 0;
  if (n > product.maxIngredients) {
    throw new Error(`${f.data.name} lists ${n} ingredients. The rule is never more than ${product.maxIngredients}.`);
  }
}
// "Organic" identifies an INGREDIENT (the supplier's juice is certified), never
// the drink, which is not. So it stays part of the ingredient's name, set as a
// small qualifier above it rather than in the note, where it would read as a
// claim about the can. It also keeps each name on one line at display size.
// See the ORGANIC note in src/data/claims.ts.
const ORGANIC = /^organic /i;
const slots = (lead?.data.ingredients ?? []).map((_, i) => {
  const raw = flavors.map((f) => f.data.ingredients?.[i] ?? '');
  const qualifier = raw.every((v) => ORGANIC.test(v)) ? 'Organic' : undefined;
  const values = flavors.map((f, j) => {
    const v = qualifier ? raw[j]!.replace(ORGANIC, '') : raw[j]!;
    return { id: f.id, value: v.charAt(0).toUpperCase() + v.slice(1) };
  });
  const varies = new Set(values.map((v) => v.value)).size > 1;
  return { varies, values, qualifier, note: landing.six.notes[i] };
});

// The switcher is plain radio inputs and CSS :has(), so it works without
// JavaScript and degrades to the lead SKU's list where :has() is unsupported.
const switcherCss = flavors
  .map((f) => {
    const c = f.data.color;
    return [
      `.six:has(#sku-${f.id}:checked) { --sku: ${c?.ink ?? 'var(--color-accent-text)'}; }`,
      `.six:has(#sku-${f.id}:checked) [data-sku]:not([data-sku="${f.id}"]) { display: none; }`,
    ].join('\n');
  })
  .join('\n');

const skuStyle = (f: (typeof flavors)[number]) =>
  f.data.color ? `--field: ${f.data.color.field}; --on-field: ${f.data.color.onText}` : undefined;

const pair = (f: (typeof flavors)[number]) => {
  // "Cranberry and pear." from the two juice lines, so it follows the label.
  const juices = (f.data.ingredients ?? []).filter((i) => / juice$/i.test(i));
  const names = juices.map((j, i) => {
    const word = j.replace(/^organic /i, '').replace(/ juice$/i, '');
    return i === 0 ? word.charAt(0).toUpperCase() + word.slice(1) : word.toLowerCase();
  });
  return names.length ? `${names.join(' and ')}.` : undefined;
};
const spec = `${product.caffeineMg} mg caffeine. ${product.lTheanineMg} mg L-theanine. ${product.canFlOz} fl oz.`;
---

<BaseLayout title={copy.home.seo.title} description={copy.home.seo.description} minimalHeader={true}>
  <JsonLd schema={organizationSchema()} />
  <Fragment set:html={`<style>${switcherCss}</style>`} />

  {/* 1. HERO */}
  <section class="hero">
    <div class="container grid">
      <div class="hero__mark">
        <Tally size={0.9} />
      </div>
      <div class="hero__body">
        <h1 class="hero__headline display">{landing.hero.headline}</h1>
        <div class="hero__sub">
          {landing.hero.sub.map((p) => <p>{p}</p>)}
        </div>
        <div class="hero__action">
          <a class="cta plain" href={landing.hero.ctaHref}>{landing.hero.ctaLabel}</a>
          <p class="hero__product caption">
            {landing.hero.productLine}
            <br /><a href="#math">{landing.hero.estimateNote}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 2. THE RULE */}
  <section class="section rule" aria-labelledby="rule-heading">
    <div class="container grid">
      <p class="label margin">{landing.rule.label}</p>
      <div class="rule__body">
        <h2 id="rule-heading" class="rule__heading display">{landing.rule.heading}</h2>
        <div class="rule__text">
          {landing.rule.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* 3. THE SIX. The largest type on the page. */}
  <section class="section six" aria-labelledby="six-heading">
    <div class="container grid">
      <p class="label margin">{landing.six.label}</p>

      <div class="six__body">
        <h2 id="six-heading" class="visually-hidden">{landing.six.heading}</h2>

        {flavors.length > 1 && (
          <fieldset class="switcher">
            <legend class="caption switcher__legend">{landing.six.switcherLabel}</legend>
            {flavors.map((f, i) => (
              <span class="switcher__option">
                <input
                  class="visually-hidden"
                  type="radio"
                  name="sku"
                  id={`sku-${f.id}`}
                  value={f.id}
                  checked={i === 0}
                />
                <label for={`sku-${f.id}`}>{f.data.name}</label>
              </span>
            ))}
          </fieldset>
        )}

        <ol class="six__list">
          {slots.map((slot, i) => (
            <li class="six__item">
              <span class="six__n" aria-hidden="true">{i + 1}</span>
              <span class="six__name">
                {slot.qualifier && <span class="six__qual">{slot.qualifier} </span>}
                {slot.varies
                  ? slot.values.map((v) => (
                      <span class="six__variant" data-sku={v.id}>{v.value}</span>
                    ))
                  : slot.values[0]?.value}
              </span>
              {slot.note && <span class="six__note">{slot.note}</span>}
            </li>
          ))}
        </ol>

        <ul class="facts">
          {landing.six.facts.map((f) => (
            <li>
              <span class="facts__value">{f.value}</span>
              <span class="facts__text">{f.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 4. THE MATH. A receipt, not a graphic. */}
  <section class="section math" id="math" aria-labelledby="math-heading">
    <div class="container grid">
      <p class="label margin">{landing.math.label}</p>
      <div class="math__body">
        <h2 id="math-heading" class="math__heading">{landing.math.heading}</h2>

        {[landing.math.money, landing.math.time].map((block) => (
          <table class="receipt">
            <caption class="label">{block.heading}</caption>
            <tbody>
              {block.rows.map((r) => (
                <tr>
                  <th scope="row">{r.item}</th>
                  <td>{r.amount}</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">{block.total.item}</th>
                <td>{block.total.amount}</td>
              </tr>
            </tfoot>
          </table>
        ))}

        <div class="math__notes caption">
          {assumptions.map((a) => <p>{a}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* 5. THE DRINKS. Cranberry leads and takes the most room. */}
  <section class="section drinks" aria-labelledby="drinks-heading">
    <div class="container grid">
      <p class="label margin">{landing.drinks.label}</p>
      <h2 id="drinks-heading" class="drinks__heading">{landing.drinks.heading}</h2>
    </div>

    <div class="container">
      <ul class="drinks__grid">
        {flavors.map((f, i) => (
          <li class:list={['drink', { 'drink--lead': i === 0 }]} style={skuStyle(f)}>
            <div class="drink__text">
              <div class="drink__top">
                <Tally size={i === 0 ? 1.1 : 0.8} />
                {landing.drinks.kicker[f.id] && (
                  <span class="drink__kicker">{landing.drinks.kicker[f.id]}</span>
                )}
              </div>
              <h3 class="drink__name">{f.data.name}</h3>
              <div class="drink__meta">
                {pair(f) && <p class="drink__pair">{pair(f)}</p>}
                <p class="drink__spec">{spec}</p>
              </div>
            </div>
            <div class="drink__can">
              <Asset
                slot={flavorSlot(f.id, 'can-front')}
                alt={`The ${f.data.name} can, with its six ingredients printed on the front.`}
                sizes={i === 0 ? '(min-width: 48rem) 18vw, 40vw' : '(min-width: 48rem) 9vw, 28vw'}
              />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 6. SUBSCRIPTION. The one capture on the page. */}
  <section class="section subscribe" id={landing.subscription.id} aria-labelledby="subscribe-heading">
    <div class="container grid">
      <p class="label margin">{landing.subscription.label}</p>
      <div class="subscribe__body">
        <h2 id="subscribe-heading" class="subscribe__heading display">{landing.subscription.heading}</h2>
        <div class="subscribe__text">
          {landing.subscription.body.map((p) => <p>{p}</p>)}
        </div>
        <JoinForm source="subscribe" label={landing.subscription.captureLabel} />
      </div>
    </div>
  </section>

  {/* 7. FAQ. Long question, short answer. The gap is the joke. */}
  <section class="section faq" aria-labelledby="faq-heading">
    <div class="container grid">
      <h2 id="faq-heading" class="label margin">{landing.faq.label}</h2>
      <dl class="faq__list">
        {landing.faq.items.map((item) => (
          <div class="faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/forms';
</script>

<style>
  /* --- Grid -------------------------------------------------------------
     Margin column: 1-2. Content: 3-12. Collapses to one column at 48rem via
     the global .grid rule. */
  .margin {
    grid-column: 1 / span 2;
    padding-block-start: 0.6em;
  }

  /* --- 1. Hero --------------------------------------------------------- */
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .hero__mark {
    grid-column: 1 / span 2;
    color: var(--color-accent-text);
    padding-block-start: 1.1em;
  }

  .hero__body {
    grid-column: 3 / span 9;
  }

  .hero__headline {
    max-inline-size: 16ch;
    font-variation-settings: 'opsz' 72;
  }

  .hero__sub {
    margin-block-start: var(--space-lg);
    max-inline-size: 34rem;
    font-size: var(--text-h3);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }

  .hero__sub p + p {
    margin-block-start: var(--space-sm);
    color: var(--color-ink);
  }

  .hero__action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-xl);
  }

  .cta {
    display: inline-block;
    padding: 0.85rem 2.25rem;
    background-color: var(--color-ink);
    color: var(--color-on-ink);
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  .cta:hover {
    background-color: var(--color-accent);
  }

  .hero__product {
    line-height: 1.6;
  }

  /* --- 2. The rule ----------------------------------------------------- */
  .rule__body {
    grid-column: 3 / -1;
  }

  .rule__heading {
    font-size: var(--text-six);
    font-variation-settings: 'opsz' 72;
    line-height: 0.98;
  }

  .rule__text {
    margin-block-start: var(--space-xl);
    margin-inline-start: auto;
    max-inline-size: 30rem;
    font-family: var(--font-family-display);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    line-height: 1.35;
  }

  .rule__text p + p {
    margin-block-start: var(--space-sm);
  }

  /* --- 3. The six ------------------------------------------------------ */
  .six {
    --sku: var(--color-accent-text);
  }

  .six__body {
    grid-column: 3 / -1;
  }

  .switcher {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
    margin: 0 0 var(--space-lg);
    padding: 0;
    border: 0;
  }

  .switcher__legend {
    float: left;
    margin-inline-end: var(--space-sm);
  }

  .switcher label {
    cursor: pointer;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    padding-block-end: 0.15em;
    border-block-end: 1px solid transparent;
  }

  .switcher input:checked + label {
    color: var(--color-ink);
    border-block-end-color: var(--sku);
  }

  .switcher input:focus-visible + label {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .six__list {
    margin: 0;
    margin-inline-start: calc(-1 * (2rem + var(--space-md)));
    padding: 0;
    list-style: none;
    border-block-start: var(--rule-strong);
  }

  .six__item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 9rem);
    align-items: baseline;
    column-gap: var(--space-md);
    padding-block: clamp(0.6rem, 0.3rem + 1vw, 1.1rem);
    border-block-end: var(--rule);
  }

  .six__n {
    font-family: var(--font-family-display);
    font-size: var(--text-h3);
    color: var(--sku);
    transition: color var(--duration-quick) var(--ease-out);
  }

  .six__name {
    font-family: var(--font-family-display);
    font-size: var(--text-six);
    font-variation-settings: 'opsz' 72;
    font-weight: 350;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .six__qual {
    display: block;
    margin-block-end: 0.35rem;
    font-family: var(--font-family);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  /* The slot that changes by can is set in that can's colour. */
  .six__variant {
    color: var(--sku);
  }

  .six__variant + .six__variant {
    display: none;
  }

  .six__note {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-lg) var(--grid-gap);
    margin: var(--space-2xl) 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
  }

  .facts__value {
    font-family: var(--font-family-display);
    font-size: var(--text-h2);
    line-height: 1.1;
  }

  .facts__text {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    max-inline-size: 22rem;
  }

  @media (max-width: 48rem) {
    .six__list {
      margin-inline-start: 0;
    }
  }

  @media (max-width: 40rem) {
    .six__item {
      grid-template-columns: 1.75rem minmax(0, 1fr);
    }
    .six__note {
      grid-column: 2;
      margin-block-start: var(--space-3xs);
    }
  }

  /* --- 4. The math ----------------------------------------------------- */
  .math__body {
    grid-column: 3 / span 8;
  }

  .math__heading {
    font-size: var(--text-h2);
    margin-block-end: var(--space-xl);
  }

  .receipt {
    inline-size: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .receipt + .receipt {
    margin-block-start: var(--space-xl);
  }

  .receipt caption {
    text-align: start;
    padding-block-end: var(--space-2xs);
  }

  .receipt th,
  .receipt td {
    padding-block: var(--space-xs);
    vertical-align: baseline;
    border-block-start: var(--rule);
  }

  .receipt th {
    text-align: start;
    font-weight: var(--font-weight-body);
    padding-inline-end: var(--space-lg);
  }

  .receipt td {
    text-align: end;
    white-space: nowrap;
  }

  /* The total, under a dashed rule, like the bottom of a till roll. */
  .receipt tfoot th,
  .receipt tfoot td {
    border-block-start: 1px dashed var(--color-ink);
    font-weight: var(--font-weight-medium);
    padding-block-start: var(--space-sm);
  }

  .receipt tbody tr:first-child th,
  .receipt tbody tr:first-child td {
    border-block-start: var(--rule-strong);
  }

  @media (max-width: 30rem) {
    .receipt td {
      white-space: normal;
      min-inline-size: 6.5rem;
    }
  }

  .math__notes {
    margin-block-start: var(--space-lg);
    max-inline-size: var(--measure);
  }

  .math__notes p + p {
    margin-block-start: var(--space-2xs);
  }

  /* --- 5. The drinks --------------------------------------------------- */
  .drinks__heading {
    grid-column: 3 / -1;
    font-size: var(--text-h2);
  }

  .drinks__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--grid-gap);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Text on the left, the can standing on the right. The tile clips the can
     so it can sit low and large without spilling onto the paper. */
  .drink {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-md);
    padding: clamp(1.25rem, 0.8rem + 1.8vw, 2.25rem);
    padding-block-end: 0;
    background-color: var(--field);
    color: var(--on-field);
    min-block-size: 15rem;
    overflow: clip;
  }

  .drink__text {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-md);
    padding-block-end: clamp(1.25rem, 0.8rem + 1.8vw, 2.25rem);
  }

  .drink__can {
    align-self: end;
    inline-size: clamp(4.5rem, 2rem + 6vw, 7.5rem);
    margin-block-end: -1.5rem;
  }

  .drink--lead .drink__can {
    inline-size: clamp(9rem, 4rem + 12vw, 15rem);
    margin-block-end: -2.5rem;
  }

  .drink--lead {
    grid-row: 1 / span 2;
    min-block-size: clamp(28rem, 20rem + 20vw, 40rem);
  }

  .drink__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .drink__kicker {
    font-size: var(--text-small);
  }

  .drink__name {
    align-self: end;
    font-size: var(--text-h1);
    font-variation-settings: 'opsz' 72;
    line-height: 1;
  }

  /* Sized to the text column beside the can, not to the page: the longest
     name has to fit without running under it. */
  .drink--lead .drink__name {
    font-size: clamp(2.5rem, 0.9rem + 3.6vw, 4.25rem);
  }

  .drink__meta {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--text-small);
  }

  .drink__spec {
    opacity: 0.82;
  }

  /* On a phone the lead tile's text column is narrow: shrink both the name
     and the can so the longest name clears it. */
  @media (max-width: 30rem) {
    .drink--lead .drink__name {
      font-size: 2.1rem;
    }
    .drink--lead .drink__can {
      inline-size: 7.5rem;
    }
  }

  @media (max-width: 48rem) {
    .drinks__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
    .drink--lead {
      grid-row: auto;
      min-block-size: 24rem;
    }
  }

  /* --- 6. Subscription ------------------------------------------------- */
  .subscribe__body {
    grid-column: 3 / span 8;
  }

  .subscribe__heading {
    max-inline-size: 14ch;
    font-variation-settings: 'opsz' 72;
  }

  .subscribe__text {
    margin-block-start: var(--space-lg);
    max-inline-size: 36rem;
    font-size: var(--text-h3);
    line-height: 1.5;
  }

  .subscribe__text p + p {
    margin-block-start: var(--space-sm);
  }

  .subscribe :global(.join) {
    margin-block-start: var(--space-xl);
  }

  /* --- 7. FAQ ---------------------------------------------------------- */
  .faq h2.label {
    font-family: var(--font-family);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-label);
  }

  .faq__list {
    grid-column: 3 / -1;
    margin: 0;
    border-block-start: var(--rule-strong);
  }

  .faq__item {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr);
    gap: var(--space-2xs) var(--grid-gap);
