---
/**
 * Home. Consumer-facing, with the trade path present in the hero rather than
 * buried at the bottom — the layout admitting who the site is actually for.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Asset from '../components/Asset.astro';
import JsonLd from '../components/JsonLd.astro';
import SubscribeForm from '../components/forms/SubscribeForm.astro';
import { copy } from '../data/copy';
import { claims } from '../data/claims';
import { organizationSchema } from '../lib/schema';

// Unconfirmed claims never render. See src/data/claims.ts.
const composition = claims.compositionPoints.filter((p) => p.confirmed);
const absence = claims.absencePoints.filter((p) => p.confirmed);
---

<BaseLayout title={copy.home.seo.title} description={copy.home.seo.description}>
  <JsonLd schema={organizationSchema()} />

  <section class="hero">
    <div class="container grid hero__inner">
      <div class="hero__text">
        <h1 class="display">{copy.home.heroHeadline}</h1>
        {copy.home.heroSubhead && <p class="hero__sub">{copy.home.heroSubhead}</p>}
        <p class="hero__trade">
          <a href="/wholesale" class="accent">{copy.home.heroTradeLinkLabel}</a>
        </p>
      </div>

      <div class="hero__figure">
        <div class="hero__field" aria-hidden="true"></div>
        <Asset
          slot="home-hero-can"
          alt=""
          sizes="(min-width: 48rem) 34vw, 70vw"
          class="hero__can"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <div class="hero__story prose">
        {copy.home.storyHeading && <h2>{copy.home.storyHeading}</h2>}
        {copy.home.storyBody.map((p) => <p>{p}</p>)}
      </div>

      {
        (composition.length > 0 || absence.length > 0) && (
          <div class="hero__facts">
            <h2 class="visually-hidden">What's in it</h2>
            <ul class="facts">
              {composition.map((p) => (
                <li>
                  <span class="facts__label">{p.label}</span>
                  {p.detail && <span class="caption">{p.detail}</span>}
                </li>
              ))}
              {absence.map((p) => (
                <li><span class="facts__label">{p.label}</span></li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{copy.home.emailCaptureHeading}</h2>
      {copy.home.emailCaptureBody && (
        <p class="prose capture__body">{copy.home.emailCaptureBody}</p>
      )}
      <SubscribeForm id="home-subscribe" />
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/forms';
</script>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .hero__inner {
    align-items: center;
  }

  .hero__text {
    grid-column: 1 / span 7;
  }

  .hero__sub {
    max-width: var(--measure-narrow);
    margin-block-start: var(--space-md);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
    line-height: var(--leading-tight);
  }

  .hero__trade {
    margin-block-start: var(--space-lg);
    font-size: var(--text-small);
  }

  .hero__figure {
    grid-column: 9 / span 4;
    position: relative;
    display: grid;
    place-items: end center;
  }

  /* Flat, unbounded color. Not a card, not a container around the product. */
  .hero__field {
    position: absolute;
    inset-block-end: 0;
    inset-inline: -12%;
    block-size: 62%;
    background-color: var(--color-accent-field);
    transform-origin: bottom;
    animation: field-settle var(--duration-considered) var(--ease-out) both;
  }

  .hero__can {
    position: relative;
    max-inline-size: 26rem;
  }

  @keyframes field-settle {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field { animation: none; }
  }

  .hero__story {
    grid-column: 1 / span 6;
  }

  .hero__facts {
    grid-column: 8 / span 5;
  }

  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-xs);
    border-block-end: var(--rule);
  }

  .facts__label {
    font-weight: var(--font-weight-medium);
  }

  .capture__body {
    margin-block: var(--space-2xs) var(--space-md);
    color: var(--color-ink-muted);
  }

  @media (max-width: 48rem) {
    .hero__figure {
      margin-block-start: var(--space-xl);
      justify-items: start;
    }
    .hero__field {
      inset-inline: -8% 40%;
    }
  }
</style>
