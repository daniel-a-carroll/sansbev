---
/**
 * PRE-LAUNCH LANDING PAGE.
 *
 * The only job is turning a visitor into an email subscriber. There is no
 * product for sale and will not be for months.
 *
 * STRUCTURE: every section names a problem the reader already feels, gives the
 * solution, and backs it with proof. The proof is compositional. The ingredient
 * panel is the evidence, and a six-item list a person can verify beats any
 * claim we could write. Where a photographed label does the work, the copy
 * stays out of the way.
 *
 * EVERY SECTION ENDS WITH A CAPTURE, each tagged with its own `source`, so
 * someone convinced by the juice section never has to scroll to the ask, and so
 * we learn which proof actually converts.
 *
 * Section order follows the spec's priority: the label and juice sections do
 * the most work because their proof is unfalsifiable.
 *
 * Copy lives in src/data/landing.ts. Read the header there before editing: it
 * lists what must never appear on this page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Asset from '../components/Asset.astro';
import JsonLd from '../components/JsonLd.astro';
import IngredientPanel from '../components/IngredientPanel.astro';
import CompetitorLabel from '../components/CompetitorLabel.astro';
import JoinForm from '../components/forms/JoinForm.astro';
import Reactions from '../components/Reactions.astro';
import { getCollection } from 'astro:content';
import { landing } from '../data/landing';
import { copy } from '../data/copy';
import { flavorSlot } from '../lib/assets';
import { organizationSchema } from '../lib/schema';

const flavors = (await getCollection('flavors', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const lead = flavors[0];

// Panels render per flavour, from the flavor data, so they can never disagree
// with the can. The lists differ only in the juice blend.
const fieldStyle = lead?.data.color ? `--field: ${lead.data.color.field}` : undefined;

const theanineAmounts = [...new Set(
  flavors.map((f) => f.data.lTheanineMg).filter((v): v is number => v !== undefined)
)];
const theanineMg = theanineAmounts.length === 1 ? theanineAmounts[0] : undefined;
const caffeineAmounts = [...new Set(
  flavors.map((f) => f.data.caffeineMg).filter((v): v is number => v !== undefined)
)];
const caffeineMg = caffeineAmounts.length === 1 ? caffeineAmounts[0] : undefined;
---

<BaseLayout
  title={copy.home.seo.title}
  description={copy.home.seo.description}
  minimalHeader={true}
>
  <JsonLd schema={organizationSchema()} />

  {/* 1. HERO. The visual is the panel, not a lifestyle shot. Capture is above
       the fold: nobody should have to scroll to subscribe.

       Every flavour's can and list is rendered, with the lead one shown and the
       controls hidden. src/scripts/flavor-carousel.ts reveals the controls and
       switches between them, so with JavaScript off this is exactly the static
       hero it was before, with no dead buttons.

       Cycling is also on-message: the only line that changes between flavours
       is the juice. The list makes that visible without a sentence about it. */}
  <section class="hero">
    <div class="container grid hero__inner" data-flavor-carousel>
      <div class="hero__text">
        <p class="label">{landing.hero.eyebrow}</p>
        <h1 class="hero__headline display">{landing.hero.headline}</h1>
        <p class="hero__sub">{landing.hero.subheadIntro}</p>

        <div class="hero__panels">
          {flavors.map((flavor, i) => (
            <div class="hero__panel" data-flavor-panel={i} hidden={i !== 0}>
              <IngredientPanel
                ingredients={flavor.data.ingredients ?? []}
                numbered={true}
              />
            </div>
          ))}
        </div>

        <JoinForm source="hero" label={landing.hero.captureLabel} />
      </div>

      <div class="hero__figure">
        {/* The stage is the coloured rectangle AND the clipping window. Cans
            slide within it, so one leaving simply disappears at the colour's
            edge rather than tracking across the cream page. */}
        <div class="hero__stage" style={fieldStyle}>
          <div class="hero__field" data-flavor-field aria-hidden="true"></div>
          <div class="hero__wipe" data-flavor-wipe aria-hidden="true"></div>

          {flavors.map((flavor, i) => (
            <div class="hero__can" data-flavor-can={i} hidden={i !== 0}
                 data-can-name={flavor.data.name}
                 data-can-color={flavor.data.color?.field}>
              <Asset
                slot={flavorSlot(flavor.id, 'can-front')}
                alt={`The front of the ${flavor.data.name} can, showing its full ingredient list.`}
                sizes="(min-width: 48rem) 28vw, 60vw"
                loading="eager"
              />
            </div>
          ))}
        </div>

        {/* Hidden until the script runs, so no-JS never sees a dead control. */}
        <div class="flavors" data-flavor-controls hidden>
          <button type="button" class="flavors__btn" data-flavor-prev aria-label="Previous flavour">
            <span aria-hidden="true">&#8592;</span>
          </button>
          <span class="flavors__name" data-flavor-current aria-live="polite">
            {lead?.data.name}
          </span>
          <button type="button" class="flavors__btn" data-flavor-next aria-label="Next flavour">
            <span aria-hidden="true">&#8594;</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  {/* 2. READ THE LABEL. The longest section, and the most load-bearing. Ours
       beside theirs at comparable size; the length differential argues. */}
  <section class="section proof">
    <div class="container">
      <p class="proof__problem">{landing.label.problem}</p>
      <h2>{landing.label.heading}</h2>
      {landing.label.body.map((p) => <p class="proof__body prose">{p}</p>)}

      <div class="grid compare">
        <div class="compare__ours">
          {flavors.map((flavor, i) => (
            <div data-flavor-panel={i} hidden={i !== 0}>
              <IngredientPanel
                ingredients={flavor.data.ingredients ?? []}
                heading={landing.label.oursHeading}
                numbered={true}
              />
            </div>
          ))}
        </div>
        <div class="compare__theirs">
          <p class="label compare__theirs-heading">{landing.label.theirsHeading}</p>
          {landing.label.competitors.map((c) => (
            <CompetitorLabel
              asset={c.asset}
              brand={c.brand}
              caption={c.caption}
              showBrand={false}
              sizes="(min-width: 48rem) 55vw, 90vw"
            />
          ))}
        </div>
      </div>

      <JoinForm source="label" label={landing.label.captureLabel} />
    </div>
  </section>

  {/* 3. REAL JUICE. Our 20% is the headline; their 0% is the caption to the
       evidence. Setting a competitor's line in the largest type on the section
       would spend our emphasis amplifying their phrase. */}
  <section class="section proof">
    <div class="container">
      <p class="proof__problem">{landing.juice.problem}</p>
      <h2 class="juice__claim">{landing.juice.heading}</h2>
      {landing.juice.subhead && <p class="juice__sub">{landing.juice.subhead}</p>}
      {landing.juice.body.map((p) => <p class="proof__body prose">{p}</p>)}

      {landing.juice.competitors.length > 0 && (
        <div class="theirs">
          <h3 class="theirs__heading">{landing.juice.competitorHeading}</h3>
          {landing.juice.competitorNote && (
            <p class="theirs__note prose">{landing.juice.competitorNote}</p>
          )}
        </div>
      )}

      {landing.juice.competitors.length > 0 && (
        <ul class="evidence">
          {landing.juice.competitors.map((c) => (
            <li>
              <CompetitorLabel
                asset={c.asset}
                brand={c.brand}
                caption={c.caption}
                sizes="(min-width: 48rem) 30vw, 90vw"
              />
            </li>
          ))}
        </ul>
      )}

      <JoinForm source="juice" label={landing.juice.captureLabel} />
    </div>
  </section>

  {/* 4. NOTHING TO SWEETEN IT. State the sugar number ourselves. Omitting it
       would be the one dishonest move on a page built on not overstating. */}
  <section class="section proof">
    <div class="container">
      <p class="proof__problem">{landing.sweetener.problem}</p>
      <h2>{landing.sweetener.heading}</h2>
      {landing.sweetener.body.map((p) => <p class="proof__body prose">{p}</p>)}

      {landing.sweetener.facts.length > 0 && (
        <ul class="facts">
          {landing.sweetener.facts.map((f) => (
            <li>
              <span class="facts__value display">{f.value}</span>
              <span class="facts__label">{f.label}</span>
            </li>
          ))}
        </ul>
      )}

      {landing.sweetener.categorySweeteners.length > 0 && (
        <div class="sweeteners">
          <h3 class="sweeteners__heading">{landing.sweetener.categorySweetenersHeading}</h3>
          <p class="sweeteners__note caption">{landing.sweetener.categorySweetenersNote}</p>
          <ul class="sweeteners__list">
            {landing.sweetener.categorySweeteners.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      )}

      <JoinForm source="sweetener" label={landing.sweetener.captureLabel} />
    </div>
  </section>

  {/* 6. THE CONSTRAINT. The most shareable element on the page, so it gets the
       one dark band. Rules the brand is bound by, not features it added. */}
  <section class="band band--flavor constraint">
    <div class="container">
      <h2 class="constraint__heading">{landing.constraint.heading}</h2>
      {landing.constraint.intro && (
        <p class="constraint__intro prose">{landing.constraint.intro}</p>
      )}
      <ul class="constraint__rules">
        {landing.constraint.rules.map((r) => <li>{r}</li>)}
      </ul>
      <JoinForm source="constraint" label={landing.constraint.captureLabel} tone="dark" />
    </div>
  </section>

  {/*
    5. CAFFEINE AND L-THEANINE.

    DELIBERATELY THE SHORTEST SECTION, and placed late. It is the only place the
    reader is asked to trust research rather than read a label, which makes it
    the weakest proof on the page and the most tempting to overwrite.

    !! REGULATORY REVIEW REQUIRED BEFORE LAUNCH !!
    This is the one section that describes what an ingredient does. On a
    CONVENTIONAL FOOD a structure/function claim must derive from nutritive
    value, and L-theanine is not generally treated as nutritive. The research is
    presented AS RESEARCH, on the two compounds and not on this drink, and the
    note beside it says so explicitly. Do not paraphrase the findings into a
    claim about the can. See src/data/claims.ts.
  */}
  <section class="section proof pairing">
    <div class="container">
      <p class="proof__problem">{landing.pairing.problem}</p>
      <h2>{landing.pairing.heading}</h2>

      <div class="grid pairing__inner">
        <div class="pairing__amounts">
          {caffeineMg !== undefined && (
            <p class="pairing__amount">
              <span class="display">{caffeineMg}<span class="pairing__unit">mg</span></span>
              <span class="pairing__what">caffeine, from green coffee beans</span>
            </p>
          )}
          {theanineMg !== undefined && (
            <p class="pairing__amount">
              <span class="display">{theanineMg}<span class="pairing__unit">mg</span></span>
              <span class="pairing__what">L-theanine, from green tea</span>
            </p>
          )}
        </div>

        <div class="pairing__text prose">
          {landing.pairing.body.map((p) => <p>{p}</p>)}
          <h3>{landing.pairing.researchHeading}</h3>
          <p class="caption">{landing.pairing.researchNote}</p>
          <ol class="research">
            {landing.pairing.research.map((r) => (
              <li>
                {r.url ? <a href={r.url}>{r.citation}</a> : r.citation}
              </li>
            ))}
          </ol>
        </div>
      </div>

      <JoinForm source="pairing" label={landing.pairing.captureLabel} />
    </div>
  </section>

  {/* 7. REACTIONS. Built, and hidden until there is something real in it. */}
  <Reactions />

</BaseLayout>

<script>
  import '../scripts/forms';
  import '../scripts/flavor-carousel';
</script>

<style>
  .hero {
    padding-block: var(--space-xl) 0;
    overflow-x: clip;
  }

  .hero__inner {
    align-items: start;
  }

  .hero__text {
    grid-column: 1 / span 7;
  }

  .hero__headline {
    margin-block-start: var(--space-2xs);
  }

  .hero__sub {
    margin-block-start: var(--space-md);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
  }

  .hero__panel {
    margin-block-start: var(--space-md);
    max-inline-size: 26rem;
  }

  .hero__figure {
    grid-column: 9 / span 4;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-block-start: var(--space-lg);
  }

  /* The coloured rectangle, and the window the cans move inside. `clip` rather
     than `hidden` so it never becomes a scroll container. It bleeds off the
     right exactly as the field did before. */
  .hero__stage {
    grid-row: 1;
    position: relative;
    overflow: clip;
    margin-inline: 10% -30%;
    display: grid;
    place-items: end center;
    padding-block-start: var(--space-lg);
  }

  .hero__field {
    position: absolute;
    inset: 0;
    background-color: var(--field, var(--color-accent));
    transform-origin: bottom;
    /* On first load there is nothing behind, so the base itself rises. */
    animation: field-rise var(--duration-considered) var(--ease-out) both;
  }

  /* The incoming colour, rising over the outgoing one. Idle at zero height. */
  .hero__wipe {
    position: absolute;
    inset: 0;
    background-color: var(--wipe, transparent);
    transform-origin: bottom;
    transform: scaleY(0);
  }

  /* Stacked in one cell so a switch cannot shift layout, and so the outgoing
     and incoming cans can occupy the same space mid-transition. */
  .hero__can {
    grid-area: 1 / 1;
    position: relative;
    align-self: end;
    will-change: transform, opacity;
  }

  .hero__stage :global(.asset) {
    max-inline-size: 15rem;
  }

  .flavors {
    grid-row: 2;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
  }

  .flavors__btn {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    background: transparent;
    border: 1px solid var(--color-rule-strong);
    border-radius: 50%;
    cursor: pointer;
    font-size: var(--text-body);
    line-height: 1;
  }

  .flavors__btn:hover {
    border-color: var(--color-ink);
  }

  .flavors__name {
    min-inline-size: 7ch;
    text-align: center;
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
  }

  @keyframes field-rise {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field { animation: none; }
  }

  /* Each proof section opens by naming the problem in the reader's words. */
  .proof__problem {
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
    margin-block-end: var(--space-2xs);
    max-inline-size: var(--measure);
  }

  .proof__body {
    margin-block-start: var(--space-sm);
  }

  /* Our claim is the largest thing in the section. */
  .juice__claim {
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-inline-size: 18ch;
  }

  .juice__sub {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
  }

  /* Their disclosure, one level down: a caption to the evidence rather than
     our argument. */
  .theirs {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-strong);
  }

  .theirs__heading {
    font-size: var(--text-h3);
  }

  .theirs__note {
    margin-block-start: var(--space-2xs);
    color: var(--color-ink-muted);
  }

  .evidence {
    margin-block-start: var(--space-md) !important;
  }

  .compare {
    margin-block-start: var(--space-xl);
    align-items: start;
  }

  .compare__ours {
    grid-column: 1 / span 4;
  }

  .compare__theirs {
    grid-column: 6 / span 7;
  }

  .compare__theirs-heading {
    margin-block-end: var(--space-sm);
  }

  .evidence {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--grid-gap);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  /* A plain wrapped list. The length is the argument, so it is set small and
     dense and given no emphasis of its own. */
  .sweeteners {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule-strong);
  }

  .sweeteners__heading {
    font-size: var(--text-h3);
  }

  .sweeteners__note {
    margin-block-start: var(--space-3xs);
    max-inline-size: var(--measure);
  }

  .sweeteners__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    margin-block-start: var(--space-md);
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    max-inline-size: 60rem;
  }

  .sweeteners__list li::after {
    content: '·';
    margin-inline-start: var(--space-sm);
    opacity: 0.5;
  }

  .sweeteners__list li:last-child::after {
    content: none;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    gap: var(--space-3xs);
  }

  .facts__value {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4rem);
    line-height: 1;
  }

  .facts__label {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    max-inline-size: 12rem;
  }

  /* Deep green from the lime can. Cream on it is 5.49, AA. */
  .constraint {
    --band: var(--c-lime);
    --band-on: var(--c-cream);
  }

  .constraint__heading {
    max-inline-size: var(--measure);
  }

  .constraint__intro {
    margin-block-start: var(--space-sm);
    opacity: 0.85;
  }

  .constraint__rules {
    margin-block-start: var(--space-lg);
    padding: 0;
    list-style: none;
    border-block-start: 1px solid color-mix(in srgb, currentColor 55%, transparent);
    max-inline-size: 44rem;
  }

  .constraint__rules li {
    padding-block: var(--space-sm);
    border-block-end: 1px solid color-mix(in srgb, currentColor 26%, transparent);
    font-size: var(--text-h3);
  }

  .pairing__amounts {
    grid-column: 1 / span 4;
  }

  .pairing__text {
    grid-column: 6 / span 7;
  }

  .pairing__amount {
    display: grid;
    gap: var(--space-3xs);
  }

  .pairing__amount + .pairing__amount {
    margin-block-start: var(--space-lg);
  }

  .pairing__amount .display {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .pairing__unit {
    font-size: 0.35em;
    font-weight: var(--font-weight-heading);
    margin-inline-start: 0.12em;
  }

  .pairing__what {
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .research {
    margin-block-start: var(--space-sm);
    padding-inline-start: var(--space-md);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
  }

  .research li + li {
    margin-block-start: var(--space-2xs);
  }
</style>
