---
/**
 * Product index. One entry per SKU from the flavors collection.
 *
 * Each card takes its color field from the flavor's own data, so a new SKU
 * needs no CSS. Drafts are excluded from the build.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Asset from '../../components/Asset.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getCollection } from 'astro:content';
import { copy } from '../../data/copy';
import { flavorSlot } from '../../lib/assets';
import { faqSchema } from '../../lib/schema';

const flavors = (await getCollection('flavors', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

const faq = (await getCollection('faq'))
  .filter((e) => e.data.audience !== 'trade')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title={copy.product.seo.title} description={copy.product.seo.description}>
  <JsonLd schema={faqSchema(faq)} />

  <section class="section">
    <div class="container">
      <h1>{copy.product.heading}</h1>
      {copy.product.intro && <p class="prose lede">{copy.product.intro}</p>}
    </div>
  </section>

  <section class="section board">
    <div class="container">
      <!--
        The brand board. Its copy lives in the pixels, so it is transcribed
        into imageClaims in src/data/claims.ts and the build lint scans that
        transcript. The alt text describes the image factually rather than
        repeating its marketing lines: republishing effect claims as HTML text
        would make them site copy, which the written copy deliberately avoids.
      -->
      <Asset
        slot="brand-board"
        alt="The three SANS flavors side by side, lime, pineapple and cranberry, each can listing its five ingredients."
        sizes="(min-width: 78rem) 1248px, 100vw"
      />
    </div>
  </section>

  {
    flavors.length > 0 && (
      <section class="section">
        <div class="container">
          <ul class="lineup">
            {flavors.map((flavor) => (
              <li class="lineup__item">
                <a href={`/product/${flavor.id}`} class="plain lineup__link">
                  <div
                    class="lineup__field"
                    style={
                      flavor.data.color
                        ? `--field: ${flavor.data.color.field}`
                        : undefined
                    }
                  >
                    <Asset
                      slot={flavorSlot(flavor.id, 'can-front')}
                      alt=""
                      sizes="(min-width: 60rem) 30vw, 80vw"
                      class="lineup__can"
                    />
                  </div>
                  <h2 class="lineup__name">{flavor.data.name}</h2>
                  {flavor.data.tagline && (
                    <p class="caption">{flavor.data.tagline}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    faq.length > 0 && (
      <section class="section">
        <div class="container">
          <h2>Questions</h2>
          <dl class="faq prose">
            {faq.map((entry) => (
              <div class="faq__item">
                <dt>{entry.data.question}</dt>
                <dd>{entry.data.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .lede {
    margin-block-start: var(--space-sm);
    font-size: var(--text-h3);
    color: var(--color-ink-muted);
    line-height: var(--leading-tight);
  }

  /* Held to the container rather than bled full width: the source is 1536px,
     so a true full-bleed would upscale it on a large display. */
  .board {
    padding-block-start: 0;
  }

  .lineup {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lineup__link {
    display: grid;
    gap: var(--space-2xs);
  }

  /* The SKU color field. The cans are transparent cutouts, so they sit
     directly on it. Flat and unbounded within the cell: no border, no radius,
     no shadow. */
  .lineup__field {
    background-color: var(--field, var(--color-surface));
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    aspect-ratio: 5 / 7;
    overflow: hidden;
  }

  /* :global() - rendered inside <Asset>. See index.astro.
     46% of the card width keeps the full can, base rim included, inside the
     field: the render is 400x1010, so at this width its height lands well
     within the 5:7 card. */
  .lineup__field :global(.asset) {
    max-inline-size: 46%;
  }

  .lineup__name {
    font-size: var(--text-h3);
    margin-block-start: var(--space-2xs);
  }

  .lineup__link:hover .lineup__name {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .faq__item + .faq__item {
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: var(--rule);
  }

  .faq dt {
    font-weight: var(--font-weight-medium);
  }

  .faq dd {
    margin: var(--space-3xs) 0 0;
    color: var(--color-ink-muted);
  }
</style>
