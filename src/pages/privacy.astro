---
/**
 * Privacy policy.
 *
 * The body describes what this site actually does — email + ZIP capture,
 * forwarded by Resend, nothing stored server-side, cookie-free analytics. It
 * still needs legal review; that requirement is written into the page itself
 * as a placeholder so it cannot be quietly forgotten.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { copy } from '../data/copy';
---

<BaseLayout
  title={copy.legal.privacy.seo.title}
  description={copy.legal.privacy.seo.description}
>
  <LegalPage page={copy.legal.privacy} />
</BaseLayout>
