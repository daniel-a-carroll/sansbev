---
/**
 * The only layout. Every page renders through it.
 */
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogSlot?: string;
  noindex?: boolean;
  /** Hides the primary nav. See SiteHeader. */
  minimalHeader?: boolean;
}

const { title, description, ogSlot, noindex, minimalHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} ogSlot={ogSlot} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader minimal={minimalHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
