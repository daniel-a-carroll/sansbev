---
/**
 * Site header.
 *
 * No hamburger menu, and that is deliberate: five short nav items wrap onto
 * two lines at 375px perfectly legibly, which means the navigation works with
 * zero JavaScript, has no disclosure state to get trapped in, and needs no
 * focus management. A toggle here would add complexity and remove capability.
 *
 * Wholesale sits inline with everything else at equal visual weight — it is
 * the primary audience's entry point, per docs/DESIGN.md.
 */
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/product', label: 'Product' },
  { href: '/where-to-buy', label: 'Where to buy' },
  { href: '/wholesale', label: 'Wholesale' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="plain site-header__brand" aria-label="Home">
      <Wordmark size="md" />
    </a>

    <nav aria-label="Primary">
      <ul class="site-nav">
        {
          nav.map((item) => {
            const current = path === item.href || path.startsWith(`${item.href}/`);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['site-nav__link', { 'is-current': current }]}
                  aria-current={current ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-md);
  }

  .site-header__brand {
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .site-nav__link {
    text-decoration: none;
    color: var(--color-ink-muted);
  }

  .site-nav__link:hover {
    color: var(--color-ink);
  }

  /* Current page is marked with the accent underline rather than a filled
     pill — consistent with rules-not-cards. */
  .site-nav__link.is-current {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-text);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.32em;
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      justify-content: flex-start;
    }
  }
</style>
