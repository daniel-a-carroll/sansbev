---
/**
 * The brand wordmark.
 *
 * Falls back to a typographic setting rather than to the gray Asset
 * placeholder — a placeholder box in the header would make every page look
 * broken, and the wordmark is one of the few slots where the interim state
 * has to be presentable rather than obviously empty.
 *
 * Drop a file at src/assets/logo-wordmark.svg and this swaps automatically.
 */
import { site } from '../data/site';
import { hasAsset } from '../lib/resolve-asset';
import Asset from './Asset.astro';

interface Props {
  /** Header uses the larger setting; footer uses the smaller one. */
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
const hasLogo = hasAsset('logo-wordmark');
---

{
  hasLogo ? (
    <Asset
      slot="logo-wordmark"
      alt={site.brand.name}
      sizes="160px"
      class:list={['wordmark-img', `wordmark--${size}`, className]}
    />
  ) : (
    <span class:list={['wordmark', `wordmark--${size}`, className]}>
      {site.brand.name}
    </span>
  )
}

<style>
  .wordmark {
    display: inline-block;
    /* Heavy condensed, matching the SANS lockup on the packaging. This is a
       2KB uppercase-only subset -- see scripts/build-font.sh. Set uppercase
       because the can is uppercase and the subset carries no lowercase. */
    font-family: var(--font-family-wordmark);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 1;
  }

  .wordmark--md {
    font-size: 1.6rem;
  }

  .wordmark--sm {
    font-size: 1.125rem;
  }

  /* :global() — rendered inside <Asset>, so it carries Asset's scope id
     rather than this component's. */
  :global(.wordmark-img) {
    width: auto;
  }

  :global(.wordmark-img.wordmark--md) {
    height: 1.75rem;
  }

  :global(.wordmark-img.wordmark--sm) {
    height: 1.25rem;
  }
</style>
