---
/**
 * The brand wordmark.
 *
 * The real SVG is INLINED rather than rendered through <Asset> as an <img>.
 * That is deliberate: the artwork is authored with fill="currentColor", and an
 * <img> loads the SVG in an isolated context where page CSS cannot reach it,
 * so it would be locked to black and would ignore the design tokens. Inlined,
 * it inherits `color` from whatever it sits on, which is what lets the same
 * file render ink-on-cream in the header and cream-on-dark on a color band,
 * exactly as the packaging does.
 *
 * Cost is about 3KB gzipped per instance, against one cached request. Worth it
 * for a logo that has to change color.
 *
 * If the file is absent it falls back to a typographic setting rather than to
 * the gray <Asset> placeholder, because a placeholder box in the header would
 * make every page look broken.
 */
import { site } from '../data/site';

interface Props {
  /** Header uses the larger setting; footer uses the smaller one. */
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;

// Build-time lookup so a missing file degrades instead of failing the build.
const inlined = import.meta.glob<string>('/src/assets/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const markup = inlined['/src/assets/logo-wordmark.svg'];
---

{
  markup ? (
    <span
      class:list={['wordmark-svg', `wordmark--${size}`, className]}
      set:html={markup}
    />
  ) : (
    <span class:list={['wordmark', `wordmark--${size}`, className]}>
      {site.brand.name}
    </span>
  )
}

<style>
  /* Inline SVG inherits `color`, so the wordmark follows the design tokens
     wherever it is placed. */
  .wordmark-svg {
    display: inline-block;
    line-height: 0;
    color: currentColor;
  }

  .wordmark-svg :global(svg) {
    display: block;
    width: auto;
    height: 1em;
  }

  .wordmark-svg.wordmark--md {
    font-size: 2rem;
  }

  .wordmark-svg.wordmark--sm {
    font-size: 1.5rem;
  }

  /* Typographic fallback, used only if the SVG is missing. */
  .wordmark {
    display: inline-block;
    font-family: var(--font-family-wordmark);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    line-height: 1;
  }

  .wordmark.wordmark--md {
    font-size: 1.6rem;
  }

  .wordmark.wordmark--sm {
    font-size: 1.125rem;
  }
</style>
