---
/**
 * The brand wordmark.
 *
 * Two modes, chosen in src/data/site.ts:
 *
 *   WORDMARK_ART  an SVG basename in src/assets. Inlined, not an <img>, so the
 *                 fill can be swapped for currentColor and the mark follows
 *                 --wordmark-color. An <img> would lock it to its own colour.
 *   WORDMARK      live text, used when WORDMARK_ART is null or the file is
 *                 missing. Set it to '6' to try the numeral. Its typeface and
 *                 tracking are the --wordmark-* tokens.
 *
 * Either way the accessible name is the brand name.
 */
import { site } from '../data/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
const { name, wordmark, wordmarkArt } = site.brand;
const isNumeral = /^\d+$/.test(wordmark);

const svgs = import.meta.glob<string>('/src/assets/**/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const artPath = wordmarkArt
  ? Object.keys(svgs).find((p) => p.split('/').pop() === `${wordmarkArt}.svg`)
  : undefined;

// Strip the file's own fills, title and labelling: colour comes from CSS and
// the accessible name from the wrapper.
const art = artPath
  ? svgs[artPath]!
      .replace(/<title>[\s\S]*?<\/title>/g, '')
      .replace(/\s(role|aria-label)="[^"]*"/g, '')
      .replace(/fill="(?!none)[^"]*"/g, 'fill="currentColor"')
      .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  : undefined;
---

{art ? (
  <span
    class:list={['wordmark-art', `wordmark--${size}`, className]}
    role="img"
    aria-label={name}
    set:html={art}
  />
) : (
  <span
    class:list={['wordmark', `wordmark--${size}`, { 'wordmark--numeral': isNumeral }, className]}
    role="img"
    aria-label={name}
  >{wordmark}</span>
)}

<style>
  .wordmark-art {
    display: inline-block;
    line-height: 0;
    color: var(--wordmark-color);
  }

  .wordmark-art :global(svg) {
    display: block;
    block-size: 1em;
    inline-size: auto;
  }

  .wordmark-art.wordmark--sm { font-size: 1rem; }
  .wordmark-art.wordmark--md { font-size: 1.2rem; }
  .wordmark-art.wordmark--lg { font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }

  .wordmark {
    display: inline-block;
    font-family: var(--wordmark-family);
    font-weight: var(--wordmark-weight);
    font-variation-settings: 'opsz' 72;
    letter-spacing: var(--wordmark-tracking);
    /* Tracking adds space after the last letter too. Pull it back so the mark
       aligns optically with whatever sits under it. */
    margin-inline-end: calc(-1 * var(--wordmark-tracking));
    color: var(--wordmark-color);
    line-height: 1;
    white-space: nowrap;
  }

  /* A single numeral has no inter-letter space to track. */
  .wordmark--numeral {
    letter-spacing: 0;
    margin-inline-end: 0;
  }

  .wordmark.wordmark--sm { font-size: 1.125rem; }
  .wordmark.wordmark--md { font-size: 1.375rem; }
  .wordmark.wordmark--lg { font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }
</style>
