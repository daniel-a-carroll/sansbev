---
/**
 * One labelled form control.
 *
 * Every field gets a real <label> bound by `for`/`id`, and an error slot wired
 * through aria-describedby that exists in the DOM from the start — inserting
 * the description element only on error means some screen readers never
 * announce it.
 */

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'number' | 'textarea' | 'select';
  required?: boolean;
  autocomplete?: string;
  inputmode?: 'text' | 'numeric' | 'email';
  pattern?: string;
  maxlength?: number;
  placeholder?: string;
  hint?: string;
  options?: readonly string[];
  rows?: number;
  formId: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  inputmode,
  pattern,
  maxlength,
  placeholder,
  hint,
  options,
  rows = 4,
  formId,
} = Astro.props;

const id = `${formId}-${name}`;
const errorId = `${id}-error`;
const hintId = hint ? `${id}-hint` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');

const shared = {
  id,
  name,
  required,
  'aria-describedby': describedBy,
  'data-field': name,
};
---

<div class="field">
  <label for={id} class="field__label">
    {label}
    {!required && <span class="field__optional">(optional)</span>}
  </label>

  {hint && <p id={hintId} class="field__hint">{hint}</p>}

  {
    type === 'textarea' ? (
      <textarea {...shared} rows={rows} maxlength={maxlength} placeholder={placeholder} />
    ) : type === 'select' ? (
      <select {...shared}>
        <option value="">Choose one</option>
        {(options ?? []).map((o) => (
          <option value={o}>{o}</option>
        ))}
      </select>
    ) : (
      <input
        {...shared}
        type={type === 'number' ? 'text' : type}
        autocomplete={autocomplete}
        inputmode={inputmode}
        pattern={pattern}
        maxlength={maxlength}
        placeholder={placeholder}
      />
    )
  }

  <p id={errorId} class="field__error" data-error-for={name} hidden></p>
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  .field__label {
    font-size: var(--text-small);
    font-weight: var(--font-weight-medium);
  }

  .field__optional {
    font-weight: var(--font-weight-body);
    color: var(--color-ink-muted);
  }

  .field__hint {
    font-size: var(--text-caption);
    color: var(--color-ink-muted);
    line-height: var(--leading-tight);
  }

  input,
  select,
  textarea {
    inline-size: 100%;
    padding: var(--space-2xs) var(--space-xs);
    background-color: var(--color-bg);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-body);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent-text);
  }

  .field__error {
    font-size: var(--text-small);
    color: var(--color-accent-text);
    line-height: var(--leading-tight);
  }

  /* The invalid state is carried by the border AND the message — never by
     color alone. */
  :global([data-invalid='true']) input,
  :global([data-invalid='true']) select,
  :global([data-invalid='true']) textarea {
    border-color: var(--color-accent-text);
    border-inline-start-width: 3px;
  }
</style>
